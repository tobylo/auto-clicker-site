---
const items = [
  {
    title: 'Game-ready',
    text: 'Hotkeys work in fullscreen. Replays raw motion when a game locks the pointer.',
  },
  {
    title: 'Tray first',
    text: "Lives in the system tray. The settings window loads only while it's open.",
  },
  {
    title: 'Nothing stuck',
    text: 'Stop, quit, lock the screen or sleep: every button and key is let go.',
  },
  {
    title: 'Offline',
    text: 'Opens no connection. Installs only from its own repository.',
  },
];
---

<section class="wrap loadout" id="loadout" aria-labelledby="loadout-title">
  <h2 class="label" id="loadout-title">// 02 — Loadout</h2>
  <ol>
    {
      items.map((item, index) => (
        <li>
          <span class="index">[{String(index + 1).padStart(2, '0')}]</span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .loadout {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-top: var(--section);
  }

  h2.label {
    font-weight: 400;
  }

  ol {
    display: flex;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--line);
    border: 1px solid var(--line);
  }

  li {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 16px;
    padding: 32px;
    background: var(--bg);
  }

  .index {
    font-size: 13px;
    color: var(--green);
  }

  h3 {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  p {
    margin-top: 16px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  @media (max-width: 1080px) {
    ol {
      flex-wrap: wrap;
    }

    li {
      flex-basis: calc(50% - 1px);
    }
  }

  @media (max-width: 720px) {
    .loadout {
      gap: 24px;
    }

    ol {
      flex-direction: column;
      gap: 0;
      background: none;
      border: none;
      border-top: 1px solid var(--line);
    }

    li {
      flex-direction: row;
      gap: 16px;
      padding: 20px 0;
      border-bottom: 1px solid var(--line);
    }

    .index {
      width: 36px;
      flex-shrink: 0;
      padding-top: 4px;
      font-size: 12px;
    }

    h3 {
      font-size: 20px;
    }

    p {
      margin-top: 8px;
      font-size: 14px;
    }
  }
</style>
