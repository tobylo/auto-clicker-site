---
import { hotkeys } from '../data/facts';
---

<section class="band" id="binds" aria-labelledby="binds-title">
  <div class="wrap row">
    <div class="intro">
      <p class="tag">// 01 — Binds</p>
      <h2 id="binds-title">Three <br />keys.</h2>
      <p class="hint">Hold Ctrl+Shift. Works in fullscreen games, and every key can be rebound.</p>
    </div>
    <ul class="tiles">
      {
        hotkeys.map((hotkey) => (
          <li class="tile">
            <kbd aria-label={`Ctrl+Shift+${hotkey.key}`}>{hotkey.key}</kbd>
            <div>
              <h3>{hotkey.name}</h3>
              <p>{hotkey.does}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .band {
    background: var(--green);
    color: var(--on-green);
  }

  .row {
    display: flex;
    gap: 20px;
    padding-block: clamp(40px, 4vw, 56px);
  }

  .intro {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 12px;
    width: 240px;
    flex-shrink: 0;
  }

  .tag {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h2 {
    font-size: 44px;
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .hint {
    font-size: 14px;
    line-height: 1.6;
    font-weight: 500;
  }

  .tiles {
    display: flex;
    flex: 1;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tile {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 16px;
    padding: 28px;
    background: var(--bg);
  }

  kbd {
    font-family: inherit;
    font-size: 88px;
    line-height: 0.9;
    font-weight: 800;
    letter-spacing: -0.05em;
    color: var(--green);
  }

  h3 {
    font-size: 17px;
    font-weight: 700;
    color: var(--text);
  }

  .tile p {
    margin-top: 10px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  @media (max-width: 1080px) {
    .row {
      flex-direction: column;
    }

    .intro {
      width: auto;
    }

    h2 br {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .tiles {
      flex-direction: column;
      gap: 12px;
    }

    .tile {
      flex-direction: row;
      align-items: center;
      gap: 20px;
      padding: 20px;
    }

    kbd {
      width: 84px;
      flex-shrink: 0;
      font-size: 52px;
    }

    h2 {
      font-size: 36px;
    }
  }
</style>
