{
  "name": "auto-clicker-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "facts": "node scripts/facts.mjs fetch",
    "facts:pin": "node scripts/facts.mjs pin",
    "dev": "node scripts/facts.mjs fetch && astro dev",
    "build": "node scripts/facts.mjs fetch && astro build",
    "preview": "astro preview",
    "test": "node scripts/facts.mjs fetch && node --test tests/"
  },
  "dependencies": {
    "@astrojs/svelte": "9.1.6",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "astro": "7.4.12",
    "svelte": "5.57.3"
  }
}
