---
import { clicksPerSecond, links, systems } from '../data/program';
---

<section class="hero wrap" id="top">
  <div class="copy">
    <p class="label">&gt; {[...systems, 'Rust'].join(' · ')}</p>
    <h1>Click.<br />Record.<br /><span>Replay.</span></h1>
    <p class="lead">
      An auto clicker with macro record and playback that lives in your tray. Its hotkeys work inside
      fullscreen games, and it costs nothing while it waits.
    </p>
    <div class="actions">
      <a class="button primary" href="#install">Install →</a>
      <a class="button" href={links.guide}>Read the guide</a>
    </div>
  </div>
  <div class="number">
    <p class="big">{clicksPerSecond.value}</p>
    <p class="label">Clicks/sec · steady · {clicksPerSecond.basis}</p>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 56px 64px;
    padding-block: clamp(48px, 8vw, 120px) clamp(56px, 7vw, 96px);
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 760px;
  }

  h1 {
    font-size: clamp(56px, 7.4vw, 104px);
    line-height: 0.98;
    font-weight: 800;
    letter-spacing: -0.05em;
    color: var(--text);
  }

  h1 span {
    color: var(--green);
  }

  .lead {
    max-width: 620px;
    font-size: clamp(15px, 1.3vw, 18px);
    line-height: 1.7;
    color: var(--text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 16px;
    padding-top: 4px;
  }

  .button {
    padding: 17px 28px;
    border: 1px solid var(--green);
    color: var(--green);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .button.primary {
    background: var(--green);
    color: var(--on-green);
    font-weight: 700;
  }

  .button:hover {
    filter: brightness(1.15);
  }

  .number {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
  }

  .big {
    font-size: clamp(148px, 16.5vw, 240px);
    line-height: 0.84;
    font-weight: 800;
    letter-spacing: -0.08em;
    color: var(--green);
  }

  @supports (-webkit-text-stroke: 1px) {
    .big {
      color: transparent;
      -webkit-text-stroke: 2px var(--green);
    }
  }

  @media (max-width: 720px) {
    .actions {
      flex-direction: column;
    }

    .button {
      text-align: center;
    }

    .number {
      align-items: flex-start;
    }

    .big {
      -webkit-text-stroke-width: 1.5px;
    }
  }
</style>
